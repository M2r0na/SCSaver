# ========================================
# SCSaver
# ========================================

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python packaging
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# PyInstaller
*.spec
*.manifest

# cx_Freeze
*.cxfreeze

# Installer output
Output/
output/
installer_output/
setup_output/
*.iss.bak

# Local launcher data
# Never commit encrypted user saves, credentials, or runtime logs.
data/
log/
logs/
*.scsave
auth.dat
latestlog.txt
*.log

# Temporary and backup files
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig
*.swp
*.swo
*~

# Runtime lock and PID files
*.lock
*.pid

# StarCraft map build outputs
# Keep source maps only when they are intentionally part of the repository.
*_out.scx
*_output.scx
*_test.scx
*_TEST.scx
out*.scx

# euddraft generated and temporary files
temp/
tmp/
.euddraft/
euddraft_temp/
payload.bin

# Local EDS files may contain absolute Windows paths.
# Track a sanitized example such as example.eds instead.
*.eds
!example.eds
!examples/*.eds

# Local configuration and environment files
.env
.env.*
!.env.example
config.local.*
settings.local.*

# IDE and editor settings
.vscode/
.idea/
*.sln
*.suo
*.user
*.userosscache
*.sln.docstates

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
.directory
.Trash-*

# Archives and release packages
*.zip
*.7z
*.rar
*.tar
*.tar.gz

# Crash dumps
*.dmp
*.dump
crash_reports/

# Local test artifacts
screenshots/
test_output/
debug_output/
